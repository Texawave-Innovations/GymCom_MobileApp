{
  "expo": {
    "name": "GymCom",
    "slug": "GymCom",
    "version": "26.09.0-0.3.0",
    "orientation": "portrait",
    "icon": "./assets/gymcom-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.texawave.gymcomapp"
    },
    "android": {
      "package": "com.texawave.gymcomapp",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/gymcom-icon.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 3
    },
    "web": {
      "favicon": "./assets/gymcom-icon.png"
    },
    "plugins": [
      "expo-font",
      "expo-video"
    ]
  }
}
